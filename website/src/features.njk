---
layout: base.njk
title: Features
---

<section class='section-features-hero section-dark'>
  <div class='features-hero-inner'>
    <div class='hook-label'>CAPABILITIES</div>
    <h1 class='features-headline'>Features</h1>
    <p class='features-sub'>Everything synlynk provides across releases — from context injection to autonomous dispatch.</p>
    <div class='features-toggle'>
      <button class='toggle-btn active' data-view='layer'>OS Layer view</button>
      <button class='toggle-btn' data-view='user'>User-facing view</button>
    </div>
  </div>
</section>

<section class='section-matrix section-light'>
  <div class='matrix-inner'>
    <table class='feature-matrix'>
      <thead>
        <tr>
          <th class='col-feature'>Feature</th>
          {% for ver in features.versions %}
          <th class="col-version{% if ver.isCurrent %} current{% endif %}">
            <div class='version-label'>{{ ver.label }}</div>
            {% if ver.installUrl %}
            <a href='{{ ver.installUrl }}' class='btn-install'>↓ install</a>
            {% endif %}
            {% if ver.changelogUrl %}
            <a href='{{ ver.changelogUrl }}' class='changelog-link'>changelog →</a>
            {% endif %}
          </th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        <!-- LAYER VIEW (OS Layer) -->
        {% for group in features.layerGroups %}
        <tr class='group-row layer-view'><td colspan='{{ features.versions.length + 1 }}'>{{ group.name }}</td></tr>
        {% for feature in group.features %}
        <tr class='feature-row layer-view'>
          <td>
            <div class='feature-name'>{{ feature.name }}</div>
            <div class='feature-desc'>{{ feature.desc }}</div>
            {% if feature.link %}
            <a class='feature-blog-link' href='{{ feature.link }}' target='_blank'>origin post →</a>
            {% endif %}
          </td>
          {% for s in feature.status %}
          <td>
            {% if s %}
            <span class='check'>✓</span>
            {% else %}
            <span class='dash'>—</span>
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
        {% endfor %}

        <!-- USER VIEW (User-facing) -->
        {% for group in features.userGroups %}
        <tr class='group-row user-view'><td colspan='{{ features.versions.length + 1 }}'>{{ group.name }}</td></tr>
        {% for feature in group.features %}
        <tr class='feature-row user-view'>
          <td>
            <div class='feature-name'>{{ feature.name }}</div>
            <div class='feature-desc'>{{ feature.desc }}</div>
            {% if feature.link %}
            <a class='feature-blog-link' href='{{ feature.link }}' target='_blank'>origin post →</a>
            {% endif %}
          </td>
          {% for s in feature.status %}
          <td>
            {% if s %}
            <span class='check'>✓</span>
            {% else %}
            <span class='dash'>—</span>
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
