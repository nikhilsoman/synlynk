#!/usr/bin/env python3
"""Resilient `synlynk` launcher, installed verbatim as the `synlynk` command.

Prefers the installed `synlynk` package. When that import fails with
ModuleNotFoundError for the `synlynk` top-level package (stale editable
install pointing at a deleted checkout, removed venv, or a dispatch
sandbox with a trimmed PYTHONPATH), falls back to the `synlynk` package
of the enclosing checkout found by walking up from the current directory.
That fallback matches `python3 bin/synlynk.py <cmd>` behavior from inside
any dispatch worktree. Without an enclosing checkout, the original error
is re-raised unchanged.
"""
import os
import sys

_MARKER = ("synlynk", "__init__.py")


def find_checkout_root(start):
    """Return the nearest ancestor of `start` holding synlynk/__init__.py."""
    current = os.path.abspath(start)
    while True:
        if os.path.isfile(os.path.join(current, *_MARKER)):
            return current
        parent = os.path.dirname(current)
        if parent == current:
            return None
        current = parent


def _import_main():
    try:
        from synlynk import main
    except ModuleNotFoundError as exc:
        if (exc.name or "") not in ("synlynk",) and not (exc.name or "").startswith("synlynk."):
            raise
        try:
            root = find_checkout_root(os.getcwd())
        except OSError:
            raise exc
        if root is None:
            raise exc
        sys.path.insert(0, root)
        from synlynk import main
    return main


if __name__ == "__main__":
    sys.exit(_import_main()())
